{
  "name": "Antigravity DevBox",
  "image": "mcr.microsoft.com/devcontainers/universal:latest",
  "postCreateCommand": "curl -fsSL https://antigravity.google/cli/install.sh | bash && chmod +x start-remote.sh && (test -f preview-server.py && chmod +x preview-server.py || true) || true",
  "postStartCommand": "bash ./start-remote.sh",
  "postAttachCommand": "bash ./start-remote.sh",
  "forwardPorts": [7681],
  "portsAttributes": {
    "7681": {
      "label": "Antigravity Live Preview",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "codespace",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
